{
  "name": "screeningroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @screeningroom/api\" \"npm run dev -w @screeningroom/web\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @screeningroom/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint apps scripts eslint.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run spec:validate",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "test:persistence": "node --env-file-if-exists=.env --test scripts/persistence.test.mjs",
    "test:auth": "node --env-file-if-exists=.env --test scripts/auth.test.mjs",
    "demo": "npm run build -w @screeningroom/api && node --env-file-if-exists=.env scripts/demo.mjs",
    "provision:recruiter": "npm run build -w @screeningroom/api && node --env-file-if-exists=.env scripts/provision-recruiter.mjs",
    "fixtures": "npm run build -w @screeningroom/api && node --env-file-if-exists=.env scripts/fixtures.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "catalog": "npm run build -w @screeningroom/api && node --env-file-if-exists=.env scripts/catalog.mjs",
    "test:screenings": "node --env-file-if-exists=.env --test scripts/screenings.test.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.4.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "mongoose": "9.10.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
