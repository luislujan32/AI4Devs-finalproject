{
	admin off
	auto_https off
}

http://:{$PORT:10000} {
	redir /buzon /buzon/ 308

	@mailboxRead {
		path /buzon/*
		method GET HEAD
	}
	handle @mailboxRead {
		reverse_proxy 127.0.0.1:8026 {
			header_up -Cookie
			header_down Cache-Control "no-store"
		}
	}
	handle /buzon/* {
		respond "Buzón de solo lectura" 405
	}
	handle {
		reverse_proxy 127.0.0.1:3001
	}
}
