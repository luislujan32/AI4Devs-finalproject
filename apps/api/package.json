{
  "name": "@screeningroom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && concurrently -k \"tsc --watch --preserveWatchOutput -p tsconfig.json\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/serve-static": "12.0.0",
    "mongoose": "9.10.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": { "@types/node": "24.10.1" }
}
