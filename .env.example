# Desarrollo local: MongoDB y Mailpit de docker compose.
API_PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27018/screeningroom_demo_local
MONGO_PORT=27018
MAILPIT_SMTP_PORT=1026
MAILPIT_HTTP_PORT=8026
# Generar localmente; nunca usar un valor compartido o versionado.
SESSION_SECRET=
PUBLIC_ORIGIN=http://127.0.0.1:3001
# Las pruebas usan Mailpit. En Render, Brevo se habilita explícitamente con su clave y un remitente verificado.
MAIL_PROVIDER=mailpit
BREVO_API_KEY=
MAIL_FROM_EMAIL=

# Solo para el contenedor de demo pública (deploy/start-demo.sh).
# Generar por separado, guardar fuera de Git y cargar en Render.
# 16–128 caracteres base64/base64url; no regenerar en una base aprovisionada.
DEMO_RECRUITER_PASSWORD=
DEMO_MAIL_PASSWORD=
# En Render: MONGODB_URI apunta exclusivamente a screeningroom_demo_public;
# PUBLIC_ORIGIN se toma de RENDER_EXTERNAL_URL si no se configura explícitamente.
# Para correo real: MAIL_PROVIDER=brevo, clave Brevo y remitente verificado.
# Guía completa: docs/demo-publica.md y docs/correo-brevo.md.
